# =========================
# HTH2.0 .gitignore
# =========================

# -------------------------
# Python virtual environment
# -------------------------
backend/.venv/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Python test/cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# React / Node
# -------------------------
frontend/node_modules/
frontend/dist/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Vite
# -------------------------
frontend/.vite/

# -------------------------
# Uploaded datasets
# -------------------------
backend/storage/datasets/*
backend/storage/uploads/*
backend/storage/temp/*

# CSV / Excel files
*.csv
*.xlsx
*.xls

# -------------------------
# Generated files
# -------------------------
*.log
*.tmp

# -------------------------
# Local databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# IDE
# -------------------------
.vscode/
.idea/

# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db